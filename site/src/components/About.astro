---
import { profile } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";
---

<section id="about" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
  <SectionHeading index="01" kicker="about me" title="Developer, builder, occasional game maker." />
  <dl class="reveal mb-12 grid gap-4 sm:grid-cols-3">
    {
      profile.highlights.map((h) => (
        <div class="card p-5">
          <dt class="sr-only">{h.label}</dt>
          <dd class="font-display text-4xl font-bold text-gradient">{h.value}</dd>
          <dd class="mt-1 text-sm text-slate-400">{h.label}</dd>
        </div>
      ))
    }
  </dl>
  <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
    <div class="reveal space-y-5 text-lg leading-relaxed text-slate-400">
      {profile.about.map((p) => <p>{p}</p>)}
      <p class="pt-2 text-base">
        Code wizard at{" "}
        {
          profile.ventures.map((v, i) => (
            <>
              <a href={v.url} target="_blank" rel="noopener" class="font-medium text-white underline decoration-accent/50 underline-offset-4 hover:decoration-accent">
                {v.label}
              </a>
              {i < profile.ventures.length - 2 ? ", " : i === profile.ventures.length - 2 ? " and " : "."}
            </>
          ))
        }
      </p>
    </div>

    <div class="reveal space-y-6">
      <div class="card flex items-center gap-5 p-5">
        <img src={profile.avatar} alt={`${profile.name}'s avatar`} width="80" height="80" class="h-20 w-20 rounded-2xl ring-2 ring-accent/40" loading="lazy" />
        <div>
          <p class="font-display text-xl font-bold text-white">{profile.name}</p>
          <p class="text-sm text-slate-400">{profile.title}</p>
          <p class="mt-1 font-mono text-xs text-accent">@{profile.handle}</p>
        </div>
      </div>
      <div class="card p-5">
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500">Focus</p>
        <ul class="flex flex-wrap gap-2">
          {profile.focus.map((f) => <li class="rounded-lg bg-accent/10 px-2.5 py-1 text-sm text-accent">{f}</li>)}
        </ul>
      </div>
      <div class="card p-5">
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500">Languages</p>
        <ul class="space-y-1.5 text-sm text-slate-300">
          {profile.languages.map((l) => <li><span class="text-accent-2">▹</span> {l}</li>)}
        </ul>
      </div>
      <div class="card p-5">
        <p class="mb-3 font-mono text-xs uppercase tracking-widest text-slate-500">Currently learning</p>
        <ul class="space-y-1.5 text-sm text-slate-300">
          {profile.learning.map((l) => <li><span class="text-accent-2">▹</span> {l}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
