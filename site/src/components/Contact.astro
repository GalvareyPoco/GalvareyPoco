---
import { profile } from "../data/profile";
---

<section id="contact" class="relative scroll-mt-20 overflow-hidden px-4 py-28 sm:px-6">
  <div class="pointer-events-none absolute bottom-0 left-1/2 h-[360px] w-[700px] -translate-x-1/2 rounded-full bg-accent-2/10 blur-[120px]"></div>
  <div class="reveal relative mx-auto max-w-2xl text-center">
    <p class="font-mono text-sm text-accent"><span class="text-slate-500">05.</span> what's next?</p>
    <h2 class="mt-3 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">Let's build something.</h2>
    <p class="mt-5 text-lg text-slate-400">
      I'm always open to questions, freelance projects and interesting problems, especially in mobile, payments or games. The fastest way to reach me is LinkedIn.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={profile.socials[1].url} target="_blank" rel="noopener" class="rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-ink-950 transition hover:bg-emerald-300">
        Message me on LinkedIn
      </a>
      {
        profile.email && (
          <a href={`mailto:${profile.email}`} class="rounded-xl border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/5">
            Email me
          </a>
        )
      }
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-3 font-mono text-sm">
      {
        profile.socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" class="text-slate-400 transition hover:text-accent">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<footer class="border-t border-white/5 py-8 text-center font-mono text-xs text-slate-600">
  Built with Astro, React & Tailwind · © {new Date().getFullYear()} {profile.name}
</footer>
